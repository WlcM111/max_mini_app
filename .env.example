# Скопируйте в .env только если нужно изменить значения по умолчанию.
# Без .env команда `docker compose up -d --build` запускает локальный режим:
# бот-заглушка вместо MAX, имитация MAX Bridge в браузере, открыть http://localhost:8080
# Все значения devonly_* — только для локального запуска. Реальные секреты в git не хранятся.

# local | prod
APP_ENV=local
APP_VERSION=dev
LOG_LEVEL=info

# PostgreSQL (в prod — 32 случайных символа [A-Za-z0-9], см. scripts/generate_prod_env.py)
POSTGRES_PASSWORD=devonly_pg_admin
PG_CORE_MIGRATOR_PASSWORD=devonly_core_migrator
PG_CORE_APP_PASSWORD=devonly_core_app
PG_BOT_MIGRATOR_PASSWORD=devonly_bot_migrator
PG_BOT_APP_PASSWORD=devonly_bot_app

# MAX (prod): токен бота выдают организаторы хакатона
BOT_MODE=stub
MAX_BOT_TOKEN=
# Bot API MAX: на боевом стенде работает botapi.max.ru, там же зарегистрирована подписка на webhook
BOT_MAX_API_BASE_URL=https://botapi.max.ru
# prod: https://<домен>/max/webhook (только HTTPS, порт 443)
BOT_WEBHOOK_PUBLIC_URL=
# prod: 64 символа [A-Za-z0-9-]
BOT_WEBHOOK_SECRET=devonly-webhook-secret
BOT_STUB_USERNAME=vovremya_local_bot
# link | open_app (open_app включать только после проверки MAX-02)
BOT_OPEN_APP_BUTTON_KIND=link
BOT_GLOBAL_RPS=20

# Производный ключ проверки initData: hex(HMAC_SHA256("WebAppData", MAX_BOT_TOKEN))
# prod: python3 scripts/derive_webapp_secret.py --token-file <файл с токеном>
CORE_MAX_WEBAPP_SECRET_HEX=

# Публичный адрес (для ссылок скачивания ICS)
PUBLIC_BASE_URL=http://localhost:8080

# Edge (Caddy): локально :80; в prod — доменное имя (включает автоматический HTTPS)
EDGE_SITE_ADDRESS=:80
EDGE_HTTP_PORT=8080
EDGE_HTTPS_PORT=8443
ACME_EMAIL=devonly@localhost
# Директива CSP, управляющая встраиванием мини-приложения, целиком.
# Веб-клиент MAX открывает приложение в кадре, мобильные — в нативном WebView.
# Пустое значение полностью снимает ограничение (требуется десктопному клиенту).
EDGE_FRAME_DIRECTIVE=frame-ancestors 'self' https://max.ru https://*.max.ru

# Сборка фронтенда: true — имитация MAX Bridge (только local), false — prod
VITE_MOCK_BRIDGE=true

# Трассировка (пусто — экспорт выключен)
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- reminders-service ---
PG_REMINDERS_MIGRATOR_PASSWORD=devonly_reminders_migrator
PG_REMINDERS_APP_PASSWORD=devonly_reminders_app
REMINDERS_SCHEDULER_INTERVAL=15s
REMINDERS_SCHEDULER_BATCH=200
REMINDERS_SCHEDULER_LEASE=2m
REMINDERS_GRACE=24h
CORE_REMINDERS_RPC_TIMEOUT=2s
CORE_REMINDERS_SYNC_FLUSH_TIMEOUT=300ms

# --- core-service ---
CORE_BOT_RPC_TIMEOUT=2s
CORE_BOT_PROFILE_CACHE_TTL=10m
CORE_LAUNCH_MAX_AGE=1h
CORE_SESSION_TTL=12h
CORE_INVITE_TTL=72h
CORE_EXPORT_TTL=10m
CORE_DB_MAX_CONNS=20
# Пакет доставки событий в reminders-service (не более 200 по контракту ApplyEvents)
CORE_OUTBOX_BATCH=100
CORE_RELAY_INTERVAL=2s
CORE_RETENTION_INTERVAL=1h

# --- Языковой ассистент GigaChat (ADR-032) ---
# Ключ авторизации проекта GigaChat API: Base64(Client ID:Client Secret) из личного
# кабинета Studio. Пустое значение полностью отключает функции FR-21 и FR-22.
# Заполняется скриптом scripts/setup_gigachat_env.sh, в репозиторий не попадает.
CORE_GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B — пакеты, GIGACHAT_API_CORP — pay-as-you-go
CORE_GIGACHAT_SCOPE=GIGACHAT_API_PERS
CORE_GIGACHAT_MODEL=GigaChat-Pro
CORE_GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
CORE_GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
CORE_GIGACHAT_CA_FILE=/etc/vovremya/ca/russian_trusted_ca_bundle.pem
CORE_GIGACHAT_TIMEOUT=8s
CORE_GIGACHAT_MAX_INPUT_CHARS=2000
CORE_GIGACHAT_DAILY_TOKEN_BUDGET=200000
CORE_RATE_ASSISTANT_PER_MIN=10
