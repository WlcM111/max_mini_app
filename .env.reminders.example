# Автономный запуск reminders-service (compose.reminders.yaml). Только для локальной проверки.
# cp .env.reminders.example .env.reminders
# docker compose -f compose.reminders.yaml --env-file .env.reminders up -d --build

APP_ENV=local
LOG_LEVEL=info
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=devonly_pg_admin
PG_DATABASE=vovremya
PG_REMINDERS_MIGRATOR_PASSWORD=devonly_reminders_migrator
PG_REMINDERS_APP_PASSWORD=devonly_reminders_app
REMINDERS_SCHEDULER_INTERVAL=15s
